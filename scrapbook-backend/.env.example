# ---- Server ----
# Port the server listens on.
PORT=3000

# The server's public web address, used to build share links.
# Locally: http://localhost:3000
# After deploying: your GoDaddy domain, e.g. https://tickit.xyz
PUBLIC_URL=http://localhost:3000

# ---- MongoDB Atlas ----
# From Atlas: Connect > Drivers > copy the connection string.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scrapbook

# ---- Gemini ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- ElevenLabs ----
# Create a key in your ElevenLabs dashboard under API Keys.
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs voice library. This default is a stock voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2


